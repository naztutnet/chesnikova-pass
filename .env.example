# 32 random bytes encoded as base64. Never commit the real value.
DATA_ENCRYPTION_KEY=
APP_VERSION=dev

# Server
NODE_ENV=production
HOST=0.0.0.0
PORT=4173
DATABASE_PATH=./data/amedia-pass.sqlite
SESSION_TTL_SECONDS=43200
COOKIE_SECURE=true
ALLOW_DEMO_AUTH=false
PASSOFFICE_BASE_URL=https://po.amediastudio.ru/

# Use passoffice-web to create real requests through this PassOffice installation.
PASSOFFICE_PROVIDER=demo
PASSOFFICE_SITE_ID=8792
PASSOFFICE_ACCESS_GROUP_ID=2166
PASSOFFICE_GUEST_CATEGORY_ID=16

# Official PassOffice Open API (after Integration Server and API key are issued)
PASSOFFICE_OPEN_API_URL=
PASSOFFICE_API_KEY=

# Yandex SpeechKit. Keep real values only in the server .env file.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
